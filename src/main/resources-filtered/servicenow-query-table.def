<?xml version="1.0" encoding="UTF-8"?>
<definition:ConnectorDefinition
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:definition="http://www.bonitasoft.org/ns/connector/definition/6.1">

  <id>${servicenow-query-table.def.id}</id>
  <version>${servicenow-query-table.def.version}</version>
  <icon>servicenow.png</icon>
  <category icon="servicenow.png" id="ServiceNow"/>

  <!-- Connection -->
  <input name="instanceUrl" type="java.lang.String" mandatory="true"/>
  <input name="authMode" type="java.lang.String" mandatory="false" defaultValue="BASIC"/>
  <input name="username" type="java.lang.String" mandatory="false"/>
  <input name="password" type="java.lang.String" mandatory="false"/>
  <input name="clientId" type="java.lang.String" mandatory="false"/>
  <input name="clientSecret" type="java.lang.String" mandatory="false"/>
  <input name="apiKey" type="java.lang.String" mandatory="false"/>
  <input name="connectTimeout" type="java.lang.Integer" mandatory="false" defaultValue="30000"/>
  <input name="readTimeout" type="java.lang.Integer" mandatory="false" defaultValue="60000"/>

  <!-- Operation -->
  <input name="tableName" type="java.lang.String" mandatory="true"/>
  <input name="sysparmQuery" type="java.lang.String" mandatory="false"/>
  <input name="sysparmFields" type="java.lang.String" mandatory="false"/>
  <input name="sysparmLimit" type="java.lang.Integer" mandatory="false" defaultValue="100"/>
  <input name="sysparmOffset" type="java.lang.Integer" mandatory="false" defaultValue="0"/>

  <output name="recordsJson" type="java.lang.String"/>
  <output name="recordCount" type="java.lang.Integer"/>
  <output name="totalCount" type="java.lang.Integer"/>
  <output name="statusCode" type="java.lang.Integer"/>
  <output name="success" type="java.lang.Boolean"/>
  <output name="errorMessage" type="java.lang.String"/>

  <page id="connectionPage">
    <widget xsi:type="definition:Text" id="instanceUrlWidget" inputName="instanceUrl"/>
    <widget xsi:type="definition:Select" id="authModeWidget" inputName="authMode"/>
    <widget xsi:type="definition:Text" id="usernameWidget" inputName="username"/>
    <widget xsi:type="definition:Password" id="passwordWidget" inputName="password"/>
    <widget xsi:type="definition:Text" id="clientIdWidget" inputName="clientId"/>
    <widget xsi:type="definition:Password" id="clientSecretWidget" inputName="clientSecret"/>
    <widget xsi:type="definition:Password" id="apiKeyWidget" inputName="apiKey"/>
    <widget xsi:type="definition:Text" id="connectTimeoutWidget" inputName="connectTimeout"/>
    <widget xsi:type="definition:Text" id="readTimeoutWidget" inputName="readTimeout"/>
  </page>
  <page id="operationPage">
    <widget xsi:type="definition:Text" id="tableNameWidget" inputName="tableName"/>
    <widget xsi:type="definition:TextArea" id="sysparmQueryWidget" inputName="sysparmQuery"/>
    <widget xsi:type="definition:Text" id="sysparmFieldsWidget" inputName="sysparmFields"/>
    <widget xsi:type="definition:Text" id="sysparmLimitWidget" inputName="sysparmLimit"/>
    <widget xsi:type="definition:Text" id="sysparmOffsetWidget" inputName="sysparmOffset"/>
  </page>
</definition:ConnectorDefinition>
